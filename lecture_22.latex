\section{Uniform distribution}\label{sec:Uniform distribution} % (fold)
\begin{definition}[9.18]
    Let there be $\left[a, b\right] \subseteq \R$. $X$ is distributed uniformly on $\left[a, b\right]$,
    $X \sim Unif \left(\left[a, b\right]\right)$ if $X$ is an absolutely continuous
    random variable with the density function \[
        f_X = \displaystyle\frac{1}{b - a}\1_{\left[a, b\right]}
    \]
\end{definition}

\begin{theorem}[9.19]
    Let there be $X \sim Unif \left(\left[a, b\right]\right)$. Then \begin{enumerate}
        \item \begin{align*}
            F_X \left(t\right) = \begin{cases}
                0, &\text{ if }t < a\\
                \displaystyle\frac{t - a}{b - a}, &\text{ if }a \leq t \leq b\\
                1, &\text{ if }t > b\\
            \end{cases}
            \end{align*}
        \item \begin{align*}
                \E \left[X\right] &= \displaystyle\frac{b + a}{2} \\
                Var \left[X\right] &= \displaystyle\frac{\left(b - a\right)^2}{12}
            \end{align*}
            % TODO slide 36
    \end{enumerate}

    \begin{proof}[Proof ]
        \begin{enumerate}
            \item \begin{align*}
                    t<a \implies \displaystyle\int_{-\infty}^{t}f_X \left(x\right) dx &= \displaystyle\int_{-\infty}^{t} \displaystyle\frac{\1_{\left[a, b\right]} \left(x\right)}{b - a} dx \\
                                                                                      &= \displaystyle\int_{-\infty}^{t}0dx \\
                                                                                      &= 0 \\
                    t > b \implies \displaystyle\int_{-\infty}^{t}f_X \left(x\right)dx &= \displaystyle\int_{-\infty}^{t}\1_{\left[a, b\right]} \left(x\right) dx \\
                                                                        &= \displaystyle\int_{a}^{b}\displaystyle\frac{dx}{b - a} \\
                                                                        &= \left[\displaystyle\frac{x}{b - a}\right]_{a}^b \\
                                                                        &= \displaystyle\frac{b - a}{b - a} \\
                                                                        &= 1 \\
                    a \leq  t \leq b \implies \displaystyle\int_{-\infty}^{t}f_X \left(x\right) dx &= \displaystyle\int_{a}^{t} \displaystyle\frac{dx}{b - a} \\
                                                                                                   &= \displaystyle\frac{t - a}{b - a} \\
                \end{align*}
            \item \begin{align*}
                    \E \left[X\right] &= \displaystyle\int_{a}^{b} \displaystyle\frac{x dx}{b - a} \\
                                      &= \displaystyle\frac{1}{b - a}\left[\displaystyle\frac{x^2}{2}\right]_a^b \\
                                      &= \displaystyle\frac{b^2 - a^2}{2 \left(b - a\right)} \\
                                      &= \displaystyle\frac{b + a}{2} \\
                \end{align*}
            \item Not proven in class
            \item \begin{align*}
                    Y &= \alpha X + \beta \\
                    F_Y \left(y\right) &= \p \left(Y \leq y\right) \\
                                       &= \p \left(\alpha X + \beta \leq y\right) \\
                                       &= \p \left(\alpha X \leq y - \beta\right) \\
                                       &= \p \left(X \leq \displaystyle\frac{y - \beta}{\alpha}\right) \\
                                       &= F)X \left(\displaystyle\frac{y - \beta}{\alpha}\right) \\
                                       &= \begin{cases}
                                        0, &\text{ if }\displaystyle\frac{y - \beta}{\alpha} < a \leftrightarrow y < \alpha a + \beta \\
                                        1, &\text{ if }\displaystyle\frac{y - \beta}{\alpha} > b \leftrightarrow y > \alpha b + \beta \\
                                        \displaystyle\frac{\displaystyle\frac{y - \beta}{\alpha} - a}{b - a} \to \displaystyle\frac{y - \beta - \alpha a}{\alpha b - \alpha a}
                                        = \displaystyle\frac{y - \left(\alpha a + \beta\right)}{\left(\alpha b + \beta\right) - \left(\alpha a + \beta\right)}, &\text{ if }a \leq \displaystyle\frac{y - \beta}{\alpha} \leq b
                                        \leftrightarrow \alpha a + \beta \leq y \leq \alpha b + \beta \\
                                       \end{cases} \\
            \end{align*}
        \end{enumerate}
    \end{proof}
\end{theorem}

\begin{definition}[9.21]
    $X$ is a random variable with \textbf{exponential distribution} with parameter $\lambda > 0$,
    $X \sim Exp \left(\lambda\right)$ if $f_X = \1_{\left[0, \infty\right])} \lambda e^{-\lambda x}$
\end{definition}

\begin{theorem}[9.22]
    Let there be $X \sim Exp \left(\lambda\right)$ then \begin{enumerate}
        \item \[
                F_X \left(t\right) = \begin{cases}
                    0, &\text{ if }t < 0\\
                    1 - e^{-\lambda t},\text{ if } 0 \leq t
                \end{cases}
            \]
        \item \[
                \E \left[X\right] = \displaystyle\frac{1}{\lambda},\ Var \left[X\right] = \displaystyle\frac{1}{\lambda^2}
            \]
        \item \[
                t < \lambda \implies\ M_X \left(t\right) = \displaystyle\frac{\lambda}{\lambda - t}
            \]
        \item \[
                \alpha > 0 \implies \alpha X \sim Exp \left(\displaystyle\frac{\lambda}{\alpha}\right)
            \]
    \end{enumerate}

    \begin{proof}[Proof ]
        \begin{enumerate}
            \item Calculation
            \item Calculation
            \item \begin{align*}
                    \E \left[e^{tX}\right] &= \displaystyle\int_{-\infty}^{\infty}e^{tX} f_X \left(x\right)dx \\
                                           &= \displaystyle\int_{0}^{\infty}e^{tX} \lambda e^{-\lambda X} dx \\
                                           &= \lambda \displaystyle\int_{0}^{\infty}e^{x \left(t - \lambda\right)}dx \\
                                           &= \displaystyle\frac{\lambda}{t \lambda} \left[e^{\left(t - \lambda\right)x}\right]^{\infty}_0 \\
                                           &= \begin{cases}
                                            \infty, &\text{ if }t > \lambda\\
                                            0, &\text{ if }t = \lambda\\
                                            \displaystyle\frac{\lambda}{t - \lambda} \left(0 - 1\right) = \displaystyle\frac{\lambda}{\lambda - t}, &\text{ if } t < \lambda
                                           \end{cases}
                \end{align*}
        \end{enumerate}
    \end{proof}
\end{theorem}

\begin{theorem}[9.23]
    Let ther ebe $X \sim Exp \left(\lambda\right)$. Let there be $x_0 > 0$ We will write \[
    Y = \left(X - x_0 | X > x_0\right) \]
    then \[
        Y \stackrel{d}{=} X
    \]
    \begin{proof}[Proof ]
        $Y = X | X > x_0$. \begin{align*}
            \overline{F}_Y \left(y\right) &= \p \left(Y \leq y\right) \\
                                          &= \p \left(X - x_0 > y | X > x_0\right) \\
                                          &= \displaystyle\frac{\p \left(X - x_0 > y, X > x_0\right)}{\p \left(X > x_0\right)} \\
                                          &= \displaystyle\frac{\p \left(X > y + x_0\right)}{\p \left(X > x_0\right)} \\
                                          &= \displaystyle\frac{\overline{F}_X \left(y + x_0\right)}{\overline{F}_X \left(x_0\right)} \\
                                          &= \displaystyle\frac{e^{\left(-y + x_0\right)\lambda}}{e^{-x_0 \lambda}} \\
                                          &= e^{-y \lambda - x_0 \lambda + x_0 \lambda} \\
                                          &= e^{-y \lambda} \\
        \end{align*}
    \end{proof}
\end{theorem}

\begin{theorem}[9.24 - conclusion]
    If $Y \sim Exp \left(\lambda\right)$ then $X = \lceil Y \rceil$ enables \[
    X \sim Geo \left(1 - e^{-\lambda}\right) \]

    \begin{proof}[Proof ]
        Note $k \in \N$
        \begin{align*}
            \p \left(X > k\right) &= \p \left(\lceil Y \rceil > k\right) \\
                                  &= \p \left(Y > \lfloor k \rfloor\right) \\
                                  &= \p \left(Y > k\right) \\
                                  &= e^{-\lambda k} \\
                                  &= \left(1 - \left(1 - e^{-\lambda}\right)\right)^k \\
                                  &= \left(1 - p\right)^k \\
        \end{align*}
    \end{proof}
    This is called "discretisation of the exponential random variable"
\end{theorem}

% section Uniform distribution (end)

\section{Absolutely continuous codistribution}\label{sec:Absolutely continuous codistribution} % (fold)
\begin{definition}[8.39]
    Let there be $X, Y$ random variables on $\left(\Omega, \F, \p\right)$. The codensity
    of $X, Y$ is the integrable non negative function $f_{X, Y} : \R^2 \to \R_{\geq 0}$
    such that for all $a, b \in \R$ \begin{align*}
        \p \left(\left(X, Y\right) \in A\right) &= \displaystyle\int_{}^{}\displaystyle\int_{A}^{}f_{X, Y} \left(x, y\right) dy dx \\
        F_{X, Y} \left(a, b\right) &= \p \left(X \leq a, Y \leq b\right) \\
                                   &= \displaystyle\int_{-\infty}^{a} \displaystyle\int_{-\infty}^{b}f_{X, Y} \left(x, y\right)dy dx \\
    \end{align*}
\end{definition}

\begin{definition}[Lemma 8.42]
    As normal, we will switch the sum with an integral, the point probability with density function, and get \[
        f_X \left(x\right) = \displaystyle\int_{-\infty}^{\infty}f_{X, Y}\left(x, y\right)dy
    \]
\end{definition}

\begin{example}[]
    Let there be $f_{X, Y} \left(x, y\right) = \1_{\left[0, 1\right]^2}$
    \begin{proof}[Solution]
        \begin{enumerate}
            \item We will verify that this is indeed a density function \begin{align*}
                    1 &= \displaystyle\int_{}^{}\displaystyle\int_{\R^2}^{} f_{X, Y} \left(x, y\right)dy dx \\
                      &= \displaystyle\int_{}^{}\displaystyle\int_{\R^2}^{} \1_{\left[0, 1\right]^2} \left(x, y\right) dx dy \\
                      &= \displaystyle\int_{}^{}\displaystyle\int_{\left[0, 1\right]^2}^{} dx dy \\
                      &= \displaystyle\int_{0}^{1}\displaystyle\int_{0}^{1} dy dx \\
                      &= \displaystyle\int_{0}^{1} dx \\
                      &= 1
                \end{align*}
            \item We will calculate the residual distribution of $X$ \begin{align*}
                    f_X \left(x\right) &= \displaystyle\int_{-\infty}^{\infty} f_{X, Y} \left(x, y\right)dy \\
                                       &= \displaystyle\int_{-\infty}^{\infty} \1_{\left[0, 1\right]^2} \left(x, y\right) dy \\
                                       &= \begin{cases}
                                        \displaystyle\int_{-\infty}^{\infty}0 dy = 0, &\text{ if }x \notin \left[0, 1\right]\\
                                        \displaystyle\int_{-\infty}^{\infty}1 dy = 1, &\text{ if }x \in \left[0, 1\right]\\
                                       \end{cases}
                                       &= \1_{\left[0, 1\right]} \left(x\right) \\
                \end{align*}
            \item We will calculate the probability that $X + Y \leq 1$ \begin{align*}
                    \p \left(X + Y \leq 1\right) &= \displaystyle\int_{}^{}\displaystyle\int_{\left\{\left(x, y\right) | 0 \leq x, y, x + y \leq 1\right\}}^{} f_{X, Y} \left(x, y\right)dy dx \\
                                                 &= \displaystyle\int_{0}^{1}\displaystyle\int_{0}^{1 - x}dy dx \\
                                                 &= \displaystyle\int_{0}^{1}1 - x dx \\
                                                 &= \left[x - \displaystyle\frac{x^2}{2}\right]_0^1 \\
                                                 &= 1 - \displaystyle\frac{1}{2} \\
                                                 &= \displaystyle\frac{1}{2} \\
            \end{align*}
        \end{enumerate}
    \end{proof}
\end{example}

\begin{example}[]
    Let there be $f_{X, Y} \left(x, y\right) = \left(x + y\right)\1_{\left[0, 1\right]^2}$
    \begin{proof}[Solution]
        \begin{enumerate}
            \item We will verify that this is indeed a density function \begin{align*}
                    1 &= \displaystyle\int_{}^{}\displaystyle\int_{\R^2}^{} f_{X, Y} \left(x, y\right)dy dx \\
                      &= \displaystyle\int_{}^{}\displaystyle\int_{\R^2}^{} \left(x, y\right)\1_{\left[0, 1\right]^2} \left(x, y\right) dx dy \\
                      &= \displaystyle\int_{}^{}\displaystyle\int_{\left[0, 1\right]^2}^{} x + y dx dy \\
                      &= \displaystyle\int_{0}^{1}\displaystyle\int_{0}^{1} x + y dy dx \\
                      &= \displaystyle\int_{0}^{1} \left[xy + \displaystyle\frac{y^2}{2}\right]_0^1 dx \\
                      &= \displaystyle\int_{0}^{1}x + \displaystyle\frac{1}{2}dx \\
                      &= 1 \\
                \end{align*}
            \item We will calculate the residual distribution of $X$ \begin{align*}
                    f_X \left(x\right) &= \displaystyle\int_{-\infty}^{\infty} f_{X, Y} \left(x, y\right)dy \\
                                       &= \displaystyle\int_{-\infty}^{\infty} \left(x + y\right)\1_{\left[0, 1\right]^2} \left(x, y\right) dy \\
                                       &= \begin{cases}
                                        \displaystyle\int_{-\infty}^{\infty}0 dy = 0, &\text{ if }x \notin \left[0, 1\right]\\
                                        \displaystyle\int_{-\infty}^{\infty}\left(x + y\right) dy = \left[xy + \displaystyle\frac{y^2}{2}\right]_0^1 = x + \displaystyle\frac{1}{2}, &\text{ if }x \in \left[0, 1\right]\\
                                       \end{cases}
                    \implies f_X \left(x\right) &= \left(x + \displaystyle\frac{1}{2}\right)\1_{\left[0, 1\right]} \left(x\right)
                \end{align*}
            \item We will calculate the probability that $X + Y \leq 1$ \begin{align*}
                    \p \left(X + Y \leq 1\right) &= \displaystyle\int_{}^{}\displaystyle\int_{\left\{\left(x, y\right) | 0 \leq x, y, x + y \leq 1\right\}}^{} f_{X, Y} \left(x, y\right)dy dx \\
                                                 &= \displaystyle\int_{0}^{1}\displaystyle\int_{0}^{1 - x}\left(x + y\right)dy dx \\
                                                 &= \displaystyle\int_{0}^{1} \left[xy + \displaystyle\frac{y^2}{2}\right]_0^{1 - x} dx \\
                                                 &= \displaystyle\int_{0}^{1}x \left(1 - x\right) + \displaystyle\frac{\left(1 - x\right)^2}{2}dx \\
                                                 &= \displaystyle\int_{0}^{1}x - x^2 + \displaystyle\frac{1 - 2x + x^2}{2} dx \\
                                                 &= \displaystyle\int_{0}^{1} - \displaystyle\frac{x^2}{2} + \displaystyle\frac{1}{2} dx \\
                                                 &= \left[- \displaystyle\frac{x^3}{6} + \displaystyle\frac{x}{2}\right]_0^1 \\
                                                 &= \displaystyle\frac{1}{3}\\
            \end{align*}
        \end{enumerate}
    \end{proof}
\end{example}

% section Absolutely continuous codistribution (end)

