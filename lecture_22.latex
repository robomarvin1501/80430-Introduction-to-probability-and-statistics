\section{Reminder}\label{sec:Reminder} % (fold)
\begin{definition}[Absolutely continuous random variable]
    If there exists $f_X: \R \to \R$ such that $\p \left(X \in \left(a, b\right)\right) = \displaystyle\int_{a}^{b}f_x \left(x\right) dx$,
    then it is absolutely continuous
\end{definition}
% section Reminder (end)

\section{Expectation of absolutely continuous random variable}\label{sec:Expectation of absolutely continuous random variable} % (fold)
\begin{definition}[]
    Let there be $X$, an absolutely continuous random variable, with the density
    function $f_X$. The \textbf{expectation} of $X$ is \[
        \E \left[X\right] = \displaystyle\int_{-\infty}^{\infty}x f_X \left(x\right) dx
    \]
    If the integral absolutely converges. Otherwise $X$ \textbf{has no expectation}.
\end{definition}

\begin{theorem}[9.12]
    Let there be an absolutely continuous random variable $X$, with expectation. Then \[
        \E \left[X\right] = \displaystyle\int_{0}^{\infty}\overline{F}_X \left(x\right) dx - \displaystyle\int_{-\infty}^{0}F_X \left(x\right) dx
    \]
    \begin{proof}[Proof]
        \begin{align*}
            \displaystyle\int_{0}^{\infty}\overline{F}_X \left(t\right) dt &= \displaystyle\int_{0}^{\infty} \left(\displaystyle\int_{t}^{\infty}f_X \left(x\right) dx\right) dt \\
                                                                           &= \displaystyle\int_{0}^{\infty} \left(\displaystyle\int_{0}^{x}f_X \left(x\right)dt\right)dx \\
                                                                           &= \displaystyle\int_{0}^{\infty}x f_X \left(x\right) dx \\
            \displaystyle\int_{-\infty}^{0}F_X \left(t\right) dt &= \displaystyle\int_{-\infty}^{0} \left(\displaystyle\int_{-\infty}^{t}f_X \left(x\right) dx\right)dt \\
                                                                 &= \displaystyle\int_{-\infty}^{0} \left(\displaystyle\int_{x}^{0}f_X \left(x\right)dt\right)dx \\
                                                                 &= \displaystyle\int_{-\infty}^{0}-x f_X \left(x\right)dx \\
                                                                 &= -\displaystyle\int_{-\infty}^{0}x f_X \left(x\right) dx \\
            \implies \displaystyle\int_{0}^{\infty}\overline{F}_X \left(x\right) dx - \displaystyle\int_{-\infty}^{0}F_X \left(x\right) dx &= \displaystyle\int_{0}^{\infty}x f_X \left(x\right)dx + \displaystyle\int_{-\infty}^{0}x f_X \left(x\right)dx \\
                                                                                                                                           &\stackrel{def}{=} \E \left[X\right]
        \end{align*}
    \end{proof}
\end{theorem}

\begin{example}[9.17]
    Given a rod of length 1 metre, $X$ is a random point on the rod, whose distance from one of
    the edges is distributed continuously with the density function $f_X = \1_{\left[0, 1\right]}$.
    We break the rod at $X$, and create a kite from the two pieces. Find the expectation and
    variance of the area of the kite

    \begin{proof}[Solution]
        $X$ is the length of one of the pieces, $Y = \displaystyle\frac{X \left(1 - X\right)}{2}$  is the area of
        the kite.
        \begin{align*}
            \E \left[Y\right] &= \E \left[\displaystyle\frac{X \left(1 - X\right)}{2}\right] \\
                              &= \displaystyle\frac{1}{2} \left(\E \left[X\right] - \E \left[X^2\right]\right) \\
            \E \left[X\right] &= \displaystyle\int_{-\infty}^{\infty}t f_X \left(t\right)dt \\
                              &= \displaystyle\int_{-\infty}^{\infty}t \1_{\left[0, 1\right]} \left(t\right)dt \\
                              &= \displaystyle\int_{0}^{1}t dt \\
                              &= \displaystyle\frac{1}{2} \\
            \E \left[X^2\right] &= \displaystyle\int_{-\infty}^{\infty}t^2 f_X \left(t\right) dt \\
                                &= \displaystyle\int_{0}^{1}t^2 dt \\
                                &= \displaystyle\frac{1}{3} \\
            \implies \E \left[Y\right] &= \displaystyle\frac{1}{2} \left(\displaystyle\frac{1}{2} - \displaystyle\frac{1}{3}\right) \\
                                       &= \displaystyle\frac{1}{12} \\
        \end{align*}
    \end{proof}
\end{example}

All the properties of expectation and variance are kept:
\begin{theorem}[9.13]
    If $X$ is a random variable with expectation $g \in \F_{\R \to \R}$, then % TODO slide 23
\end{theorem}

\begin{example}[9.17]
    Now the variance of the kite:

    \begin{proof}[Solution]
        \begin{align*}
            \E \left[Y^2\right] &= \E \left[\left(\displaystyle\frac{X \left(1 - X\right)}{2}\right)^2\right] \\
                                &= \E \left[\displaystyle\frac{X^2 \left(1 - 2X + X^2\right)}{4}\right] \\
                                &= \displaystyle\frac{1}{4} \left(\E \left[X^2 - 2X^3 + X^4\right]\right) \\
                                &= \displaystyle\frac{1}{4} \displaystyle\int_{0}^{\infty} \left(x^2 - 2x^3 + x^4\right)f_X \left(x\right) dx \\
                                &= \displaystyle\frac{1}{4} \left[\displaystyle\frac{x^3}{3} - \displaystyle\frac{2x^4}{4} + \displaystyle\frac{x^5}{5}\right]_{0}^1 \\
                                &= \displaystyle\frac{1}{120} \\
            Var \left[Y\right] &= \E \left[Y^2\right] - \E \left[Y\right]^2 \\
                               &= \displaystyle\frac{1}{120} - \displaystyle\frac{1}{144} \\
                               &= \displaystyle\frac{1}{720} \\
        \end{align*}
    \end{proof}
\end{example}
