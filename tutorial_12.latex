\begin{exercise}
    Let us assume that $X, Y$ have uniform distribution on a circle of radius $1$,
    centred on $\left(0, 0\right)$. This is to say that the density function is \[
        f_{X, Y} = \begin{cases}
            \displaystyle\frac{1}{\pi}, &\text{ if }x^2 + y^2 < 1\\
            0, &\text{ else }
        \end{cases}
    \]
    \begin{enumerate}
        \item Find the density of $X$
        \item Find $\p \left(X^2 + Y^2 \leq \displaystyle\frac{1}{2}\right)$
    \end{enumerate}

    \begin{proof}[Solution]
        \begin{enumerate}
            \item \begin{align*}
                    f_X \left(t\right) &= \displaystyle\int_{-\infty}^{\infty} f_{X, Y} \left(t, y\right) dy \\
                    t < -1 \lor 1 < t \implies f_X \left(t\right) &= 0 \\
                    -1 \leq t \leq 1 \implies \displaystyle\int_{-\sqrt{1 - t^2} }^{\sqrt{1 - t^2} } \displaystyle\frac{1}{\pi} dy &= \displaystyle\frac{2 \sqrt{1 - t^2} }{\pi}\\
                    f_X \left(x\right) f_Y \left(y\right) = \displaystyle\frac{2 \sqrt{1 - x^2} }{\pi} \displaystyle\frac{2 \sqrt{1 - y^2} }{\pi}
                \end{align*}
            \item There are 2 solutions. This is effectively a smaller internal circle of radius $\displaystyle\frac{1}{2}$.
                So \[
                    \displaystyle\frac{\displaystyle\frac{\pi}{2}}{\pi} = \displaystyle\frac{1}{2}
                \]
                or \begin{align*}
                    B_{\displaystyle\frac{1}{\sqrt{2} }} &= \left\{0 \leq r \leq \displaystyle\frac{1}{\sqrt{2} }, 0 \leq \theta \leq 2\pi\right\} \\
                    \displaystyle\int_{}^{}\displaystyle\int_{B_{\displaystyle\frac{1}{\sqrt{2} }}}^{}f_{X, Y} \left(x, y\right) dx dy &=
                            \displaystyle\int_{0}^{2 \pi} \displaystyle\int_{0}^{\displaystyle\frac{1}{\sqrt{2} }}\displaystyle\frac{1}{\pi} r dr d\theta \\
                                                                                                                                          &= \displaystyle\int_{0}^{2\pi} \left[\displaystyle\frac{r^2}{2\pi}\right]_0^{\displaystyle\frac{1}{\sqrt{2} }} d\theta \\
                                                                                                                                          &= \displaystyle\int_{0}^{2\pi} \displaystyle\frac{1}{4\pi} d\theta \\
                                                                                                                                          &= \displaystyle\frac{1}{2} \\
                \end{align*}
        \end{enumerate}
    \end{proof}
\end{exercise}

\begin{exercise}
    Let there be 2 random variables $X_1 \sim Unif \left(\left[0, 1\right]\right), X_2 \sim Ber \left(\displaystyle\frac{1}{3}\right)$.
    Reminder $f_{X_1} = \1_{\left[0, 1\right]}$.
    \begin{enumerate}
        \item Show that $Y = X_1 + X_2$ is absolutely continuous, and find its density.
        \item Find the density of $Z = Y^3$
    \end{enumerate}

    \begin{proof}[Solution]
        \begin{enumerate}
            \item \begin{align*}
                    F_Y \left(t\right) &= \p \left(X_1 + X_2 \leq t\right) \\
                                       &= \begin{cases}
                                        0, &\text{ if }0 \leq t\\
                                        1, &\text{ if }2 \leq t\\
                                        \p \left(X_2 = 0 \land X_1 \leq t\right) = \p \left(X_2 = 0\right) \p \left(X_1 \leq t\right) = \displaystyle\frac{2}{3}t, &\text{ if }0 \leq t < 1\\
                                        \p \left(X_2 = 0, X_1 \in \left[0, 1\right]\right) + \p \left(X_2 = 1, X_1 \leq t - 1\right) = \displaystyle\frac{2}{3} + \displaystyle\frac{1}{3} \left(t - 1\right), &\text{ if }1 \leq t \leq 2\\
                                       \end{cases}
                    f_Y \left(t\right) &= \begin{cases}
                        0, &\text{ if }t < 0 \lor t > 2\\
                        \displaystyle\frac{2}{3}, &\text{ if }0 \leq t \leq 1\\
                        \displaystyle\frac{1}{3}, &\text{ if } 1 < t \leq 2
                    \end{cases}
                \end{align*}
            \item \begin{align*}
                    F_{Y^3} \left(t\right) &= \p \left(Y^3 \leq t\right) \\
                                           &= \p \left(Y \leq \sqrt[3]{t} \right) \\
                                           &= \begin{cases}
                                            0, &\text{ if }t < 0\\
                                            \displaystyle\frac{2}{3}\sqrt[3]{t} , &\text{ if }0 \leq t \leq 1\\
                                            \displaystyle\frac{2}{3} + \displaystyle\frac{1}{3} \left(\sqrt[3]{t} - 1\right), &\text{ if } 1 \leq t \leq 8 \\
                                            0, &\text{ if }t \geq 8\\
                                           \end{cases}
            \end{align*}
            and then we need to find the derivative for $f_{Y^3}$. That is left as
            an exercise for the reader.
        \end{enumerate}
    \end{proof}
\end{exercise}

\begin{exercise}
    In an archery competition between 3 people, the competitors shoot arrows at an infinite target
    board. the success is according to the distance from the origin. It is given that $X, Y$
    the coordinates where Robin Hood hit are independent, and that they have distribution \begin{align*}
        X, Y \sim N \left(1, 0\right)
        f_Y \left(t\right) = f_X \left(t\right) = \displaystyle\frac{1}{\sqrt{2\pi} }e^{-\displaystyle\frac{x^2}{2}}
    \end{align*}

    \begin{enumerate}
        \item The first 2 competitors, 1 and 2, hit the target at distances $r_1 < r_2$.
            What is the probability that Robin Hood will finish second?
    \end{enumerate}

    \begin{proof}[Solution]
        \begin{enumerate}
            \item \begin{align*}
                    \p \left(\left(X, Y\right) \in D\right) &= \displaystyle\int_{}^{} \displaystyle\int_{D}^{} f_{X, Y} \left(x, y\right) dx dy \\
                                                            &= \displaystyle\int_{}^{} \displaystyle\int_{D}^{}f_X \left(x\right) f_Y \left(y\right) dx dy \\
                                                            &= \displaystyle\int_{}^{} \displaystyle\int_{D}^{} \displaystyle\frac{1}{\sqrt{2 \pi} } e^{-\displaystyle\frac{x^2}{2}} \displaystyle\frac{1}{\sqrt{2\pi} } e^{-\displaystyle\frac{y^2}{2}} dx dy \\
                                                            &= \displaystyle\frac{1}{2\pi} \displaystyle\int_{}^{} \displaystyle\int_{}^{}e^{- \displaystyle\frac{\left(x^2 + y^2\right)}{2}} dx dy \\
                    D &= \left\{r_1 \leq r \leq r_2, 0 \leq \theta \leq 2\pi\right\} \\
                      &= \displaystyle\frac{1}{2\pi} \displaystyle\int_{r_1}^{r_2} \displaystyle\int_{0}^{2\pi} e^{-\displaystyle\frac{r^2}{2}} r d\theta dr \\
                      &= \displaystyle\int_{r_1}^{r_2} e^{- \displaystyle\frac{r^2}{2}} \cdot r dr  \\
                      &= \left[-e^{-\displaystyle\frac{r^2}{2}}\right]_{r_1}^{r_2} \\
                      &= -e^{-\displaystyle\frac{r_2^2}{2}} + e^{-\displaystyle\frac{r_1^2}{2}} \\
            \end{align*}
        \end{enumerate}
    \end{proof}

\end{exercise}
