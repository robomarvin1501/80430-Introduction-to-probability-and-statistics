\section{Codistribution}\label{sec:Codistribution} % (fold)
\begin{definition}[]
    Let there be $X, Y$ a pair of rabdom variables on $\left(\Omega, \F, \p\right)$.
    The \textbf{joined cumulative distribution function} of $X, Y$ is
    $F_{X, Y} : \R^2 \to \left[0, 1\right]$, which is defined \[
        F_{X, Y} \left(s, t\right) = \p \left(X \leq s, Y \leq t\right)
    \]
\end{definition}

\begin{definition}[]
    Let ther ebe $X, Y$ random variables on the same $\left(\Omega, \F, \p\right)$, we
    will say that they have joined distribution if there exists $f_{X, Y} : \R^2 \to \R$
    which is integratable, and non negative, such that for all $s, t \in \R$: \[
        F_{X, Y} \left(s, t\right) = \displaystyle\int_{-\infty}^{t} \displaystyle\int_{-\infty}^{s} f_{X, Y} \left(x, y\right) dx dy
    \]
\end{definition}

\begin{theorem}[]
    Let us assume for $X, Y$ there is joined distribution. \begin{enumerate}
        \item For all $a < b, c < d$ \[
                \p \left(a \leq X \leq b, c \leq Y \leq d\right) = \displaystyle\int_{c}^{d} \displaystyle\int_{a}^{v} f_{X, Y} \left(x, y\right) dx dy
            \]
        \item \[
                \displaystyle\int_{-\infty}^{\infty} \displaystyle\int_{-\infty}^{\infty} f_{X, Y} \left(x, y\right) dy dx = 1
            \]
        \item Continuity, and differentiability: the joined cumulative distribution function $F_{X, Y}$
            is continuous. Additionally, for every point $\left(s, t\right) \in \R^2$ where
            $f_{X, Y}$ is continuous \[
                \displaystyle\frac{d^2}{ds dt}F_{X, Y} \left(s, t\right) = f_{X, Y} \left(s, t\right)
            \]
        \item Residual density: $X, Y$ are absolutely continuous random variables with
            residual density functions. \begin{gather*}
                f_X \left(x\right) = \displaystyle\int_{-\infty}^{\infty} f_{X, Y} \left(x, y\right) dy \\
                f_Y \left(y\right) = \displaystyle\int_{-\infty}^{\infty} f_{X, Y} \left(x, y\right) dx \\
            \end{gather*}
        \item For $X, Y$ absolutely continuous random variables with expectation, for
            every function $g: \R^2 \to \R$ \[
                \E \left[g \left(X, Y\right)\right] = \displaystyle\int_{-\infty}^{\infty} \displaystyle\int_{-\infty}^{\infty} g \left(x, y\right) f_{X, Y} \left(x, y\right) dy dx
            \]
        \item If $X, Y$ are independent absolutely continuous random variables,
            then the joined density function of $\left(X, Y\right)$ is the product of
            the residual density functions of $X, Y$. \[
                f_{X, Y} \left(x, y\right)= f_X \left(x\right) f_Y \left(y\right)
            \]
    \end{enumerate}
\end{theorem}

\begin{definition}[]
    We will say that $\left(X, Y\right)$ are uniformly distributed on $D \subseteq \R^2$ if
    the density enables \[
        f_{X, Y} \left(x, y\right) = \begin{cases}
            \displaystyle\frac{1}{\text{Area of  } D}, &\text{ if }\left(x, y\right) \in D\\
            0, &\text{ else }  \\
        \end{cases}
    \]
\end{definition}

\begin{theorem}[Fubini]
    Let there be \begin{gather*}
        D = \left\{\left(x, y\right) | a \leq x \leq b, g \left(x\right) \leq y \leq h \left(x\right)\right\} \\
        f : \R^2 \to \R
    \end{gather*}
    where $g, h$ are some functions. So \[
        \displaystyle\int_{}^{} \displaystyle\int_{D}^{} f \left(x, y\right) dx dy = \displaystyle\int_{a}^{b} \left[\displaystyle\int_{g \left(x\right)}^{h \left(x\right)} f \left(x, y\right) dy\right] dx
    \]
    which is to say we can calculate the 2D integral through 2 1D integrals, one after the other.
    The theorem is also correct for the area \[
        D = \left\{\left(x, y\right) : a \leq y \leq b, g \left(y\right) \leq x \leq h \left(y\right)\right\}
    \]
    and so \[
        \displaystyle\int_{}^{} \displaystyle\int_{D}^{} f \left(x, y\right) dx dy = \displaystyle\int_{a}^{b} \left[\displaystyle\int_{g \left(y\right)}^{h \left(y\right)} f \left(x, y\right) dx\right] dy
    \]
\end{theorem}

\begin{exercise}
    A women waits for a secretary to become available in a bank. In a bank of 2 secretaries,
    the time until either one of them will become free is distributed uniformly on
    $\left[0, 10\right]$. What is the expected wait time?

    \begin{proof}[Solution]
        Let $X$ be the time until the first secretary becomes free, and $Y$ be
        the same for the second. Let there be \[
            Z = \displaystyle\min_{} \left\{X, Y\right\}
        \]
        so \[
            f_X \left(t\right) = f_Y \left(t\right) = \begin{cases}
                \displaystyle\frac{1}{10}, &\text{ if }0 \leq t \leq 10\\
                0, &\text{ else } \\
            \end{cases}
        \]
        So \begin{align*}
            \E \left[Z\right] &= \E \left[\displaystyle\min_{} \left\{X, Y\right\} \right] \\
                              &= \displaystyle\int_{-\infty}^{\infty} \displaystyle\int_{-\infty}^{\infty} \displaystyle\min_{} \left\{x, y\right\} f_{X, Y} \left(x, y\right) dx dy \\
                              &= \displaystyle\int_{-\infty}^{\infty} \displaystyle\int_{-\infty}^{\infty} \displaystyle\min_{} \left\{x, y\right\} f_X \left(x\right) f_Y \left(y\right) dx dy \\
        \end{align*}
        Let there be \begin{gather*}
            A_1 = \left\{\left(x, y\right) : 0 \leq x \leq 10, x \leq y \leq 10\right\} \\
            A_2 = \left\{\left(x, y\right) : 0 \leq y \leq 10, y \leq x \leq 10\right\}
        \end{gather*}
        and so \begin{align*}
            \displaystyle\frac{1}{100}\displaystyle\int_{}^{} \displaystyle\int_{A_1}^{} x dx + \displaystyle\frac{1}{100}\displaystyle\int_{}^{} \displaystyle\int_{A_2}^{} y dy &= \displaystyle\frac{1}{100}\displaystyle\int_{0}^{10} \displaystyle\int_{x}^{10} x dy dx + \displaystyle\frac{1}{100}\displaystyle\int_{0}^{10} \displaystyle\int_{y}^{10} y dx dy \\
            I = \displaystyle\int_{0}^{10} \displaystyle\int_{x}^{10} x dy dx &= \displaystyle\int_{0}^{10} \left[xy\right]_x^{10} dx \\
                                                                          &= \displaystyle\int_{0}^{10}10x - x^2 dx \\
                                                                          &= \left[5x^2 - \displaystyle\frac{x^3}{3}\right]_{0}^{10} \\
                                                                          &= 500 - \displaystyle\frac{1000}{3} \\
            \E \left[Z\right] &= \displaystyle\frac{2I}{100} \\
                              &= \displaystyle\frac{I}{50} \\
                              &= 10 - \displaystyle\frac{20}{3} \\
                              &= \displaystyle\frac{10}{3} \\
        \end{align*}
    \end{proof}
\end{exercise}

