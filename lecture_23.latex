    \end{proof}
\end{theorem}


\subsection{Convergence of distributions}\label{sub:Convergence of distributions} % (fold)
\subsubsection{Convergence of binomial to Poisson}\label{sec:Convergence of binomial to Poisson} % (fold)
Let us write that \begin{itemize}
    \item $Y_n \sim Bin \left(n, \displaystyle\frac{1}{n}\right)$
    \item $Y \sim Pois \left(1\right)$
    \item Prove that $Y_n \stackrel{d}{\to} Y$
\end{itemize}

\begin{align*}
    \forall k \in \N_0,\ \displaystyle\lim_{n \to \infty} \p \left(X_n = k\right) &= \p \left(X \leq k\right) \\
    \binom{n}{k} \left(\displaystyle\frac{1}{n}\right)^k \left(1 - \displaystyle\frac{1}{n}\right)^{n - k} &= \displaystyle\frac{n!}{k! \left(n - k\right)!n^k}
    \left(1 - \displaystyle\frac{1}{n}\right)^n \left(1 - \displaystyle\frac{1}{n}\right)^{-k} \\
                           &= \displaystyle\frac{1}{k!} \displaystyle\frac{n \left(n - 1\right) \dots \left(n - k + 1\right)}{n^k} \left(1 - \displaystyle\frac{1}{n}\right)^n \left(1 - \displaystyle\frac{1}{n}\right)^{-k} \\

                           &= \displaystyle\frac{e^{-1} \cdot 1^k}{k!}
\end{align*}
% subsubsection Convergence of binomial to Poisson (end)

\subsubsection{Uniform independent random variables to a continuous random variable}\label{sec:Uniform independent random variables to a continuous random variable} % (fold)
\begin{itemize}
    \item For all $n \in \N$, let $X_n \sim Unif \left(\left\{\displaystyle\frac{k}{n} : k \in \left[n\right]\right\}\right)$
    \item $X \sim Unif \left(\left[0, 1\right]\right)$
    \item Prove $X_n \stackrel{d}{\to} X$
\end{itemize}
% subsubsection Uniform independent random variables to a continuous random variable (end)

